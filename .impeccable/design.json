    {
      "name": "Homepage primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The implemented hero action opens the community.",
      "html": "<a class=\"ds-primary\" href=\"/community\">进入社区<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a>",
      "css": ".ds-primary{font:500 15px/1.65 var(--iavse-font,\"IAVSE Sans\",system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:11px 23px;border:0;border-radius:12px;text-decoration:none;transition:transform .18s,box-shadow .18s,background .18s;background:var(--iv-purple,#7446d9);color:#fff;box-shadow:0 9px 24px -10px rgb(116 70 217 / .6)}.ds-primary:hover{background:var(--iv-purple-deep,#6433c7);transform:translateY(-2px);box-shadow:0 13px 28px -10px rgb(116 70 217 / .65)}.ds-primary:active{transform:scale(.98)}.ds-primary:focus-visible{outline:3px solid var(--iv-purple,#7446d9);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary:hover,.ds-primary:active{transform:none}}"
