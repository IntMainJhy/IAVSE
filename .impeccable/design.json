      "css": ".ds-secondary{font:500 15px/1.65 var(--iavse-font,\"IAVSE Sans\",system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:11px 23px;border:0;border-radius:12px;text-decoration:none;transition:transform .18s,box-shadow .18s,background .18s;background:#fff;color:var(--iv-ink,#241c35);box-shadow:0 6px 20px -9px rgb(77 43 125 / .22)}.ds-secondary:hover{color:var(--iv-purple-deep,#6433c7);transform:translateY(-2px);box-shadow:0 10px 25px -10px rgb(77 43 125 / .26)}.ds-secondary:active{transform:scale(.98)}.ds-secondary:focus-visible{outline:3px solid var(--iv-purple,#7446d9);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}.ds-secondary:hover,.ds-secondary:active{transform:none}}"
    },
    {
      "name": "Transparent homepage navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Uncolored transparent header; the guest destination shown here does not simulate a signed-in member.",
      "html": "<header class=\"ds-nav\"><a class=\"ds-brand\" href=\"/\" aria-label=\"IAVSE 首页\"><svg width=\"27\" height=\"27\" viewBox=\"0 0 28 28\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m5 6 6 16h6l6-16M8 6l6 16M20 6l-6 16\"/></svg><span>IAVSE</span></a><nav class=\"ds-links\" aria-label=\"主要导航\"><a href=\"/community\">社区</a><a href=\"/resources\">资源</a><a href=\"/blogs\">博客空间</a></nav><a class=\"ds-login\" href=\"/login\">登录</a></header>",
      "css": ".ds-nav{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:68px;padding:9px 13px 9px 24px;border:1px solid rgb(120 120 120 / .13);border-radius:999px;background:transparent;backdrop-filter:none;color:#242424;box-shadow:0 7px 25px -12px rgb(0 0 0 / .12),inset 0 1px 0 rgb(255 255 255 / .6);font:400 14px/1.65 var(--iavse-font,\"IAVSE Sans\",system-ui,sans-serif)}.ds-nav a{color:inherit;text-decoration:none}.ds-brand{display:flex;align-items:center;gap:10px}.ds-brand span{font:600 33px/1 \"IAVSE Wordmark\",Georgia,serif;letter-spacing:-.025em}.ds-links{display:flex;gap:4px}.ds-links a{padding:8px 16px;border-radius:999px;transition:background .18s}.ds-links a:hover{background:rgb(0 0 0 / .035)}.ds-login{display:inline-flex;align-items:center;min-height:42px;padding:9px 20px;border-radius:999px;background:#242424;color:#fff!important}.ds-nav a:focus-visible{outline:3px solid var(--iv-purple,#7446d9);outline-offset:5px}@media(max-width:650px){.ds-nav{gap:9px;padding:8px 10px 8px 15px;min-height:60px}.ds-brand span{font-size:28px}.ds-links{flex-wrap:wrap}.ds-links a{padding:8px;font-size:12px}}@media(prefers-reduced-motion:reduce){.ds-links a{transition:none}}"
