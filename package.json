{
  "name": "iavse-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "prebuild": "node scripts/brand-icons.mjs && node scripts/package-skill.mjs && node scripts/version-template-covers.mjs && npm run portfolio:styles",
    "package:skill": "node scripts/package-skill.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3008",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3008",
    "setup": "node scripts/setup.mjs",
    "test": "node --test test/*.test.mjs",
    "bench:catalog": "node scripts/benchmark-catalog.mjs",
    "test:integration": "node test/integration.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "cleanup": "node scripts/cleanup.mjs",
    "typecheck": "tsc --noEmit",
    "test:community:http": "node test/community-http.mjs",
    "test:homepage:http": "node test/blog-http.mjs",
    "test:gallery:http": "node test/blog-gallery-http.mjs",
    "test:skills:http": "node test/skills-http.mjs",
    "test:catalog:http": "node test/catalog-http.mjs",
    "test:resume:http": "node test/resume-http.mjs",
    "brand:icons": "node scripts/brand-icons.mjs",
    "test:blog-editor:http": "node test/blog-editor-http.mjs",
    "test:registration:http": "node test/email-registration-http.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "portfolio:styles": "node scripts/build-portfolio-styles.mjs",
    "predev": "npm run portfolio:styles"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@xyflow/react": "12.12.0",
    "gsap": "3.15.0",
    "htmlparser2": "12.0.0",
    "jszip": "3.10.2",
    "lenis": "^1.3.23",
    "lucide-react": "^0.562.0",
    "matter-js": "^0.20.0",
    "motion": "^12.23.26",
    "next": "15.5.28",
    "nodemailer": "10.1.7",
    "ogl": "^1.0.11",
    "pdfjs-dist": "5.4.296",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@types/matter-js": "^0.20.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/three": "0.186.0",
    "@xyflow/system": "0.0.83",
    "postcss": "8.5.30",
    "tailwindcss": "^4.1.18",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.30"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "IAVSE creator community and blog platform with resource discovery, a visual editor, public blog directory, AI Skills and scoped MCP/REST integration.",
  "repository": {
    "type": "git",
    "url": "https://github.com/IntMainJhy/IAVSE.git"
  },
  "homepage": "https://github.com/IntMainJhy/IAVSE#readme",
  "bugs": {
    "url": "https://github.com/IntMainJhy/IAVSE/issues"
  },
  "author": "IntMainJhy",
  "keywords": [
    "creator-platform",
    "blog-platform",
    "portfolio",
    "visual-editor",
    "nextjs",
    "react",
    "typescript",
    "sqlite",
    "threejs",
    "agent-skills",
    "mcp",
    "self-hosted",
    "source-available"
  ]
}
