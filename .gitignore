# Publish only the website project. Local notes, screenshots, releases and data
# remain on this computer; sibling desktop clients are outside this Git root.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/README.zh-CN.md
!/LICENSE
!/NOTICE
!/CONTRIBUTING.md
!/THIRD_PARTY_NOTICES.md
!/package.json
!/package-lock.json
!/next.config.mjs
!/tsconfig.json
!/src/
!/public/
!/scripts/
!/integrations/
!/deploy/
!/test/
!/docs/
!/vendor/
/vendor/*
!/vendor/stylekit-templates/

# Dependencies, generated output, local state and credentials.
**/node_modules/
**/.next/
**/.turbo/
**/.cache/
**/.impeccable/
**/.DS_Store
**/*.log
**/*.tsbuildinfo
**/next-env.d.ts
**/.env*
**/*.env
**/*.env.*
!/.env.example
!/.env.local.example
!**/*.env.example
**/.data/
**/.site*-data/
**/*backups/
**/test-artifacts/
/test/*-result.json
/test/*-results.json
**/uploads/
**/mail-outbox/
**/initial-admin.txt
**/*.sqlite*
**/*.db
**/*.db-*
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Native clients and installers are not part of the source publication.
**/macos-client/
**/windows-client/
**/*.swift
**/*.xcodeproj/
**/*.xcworkspace/
**/*.sln
**/*.csproj
**/*.app/
**/*.dmg
**/*.exe
**/*.msi
**/*.zip

# Local image-generation metadata contains machine-specific output paths.
/public/images/**/*.prompt.txt
/public/images/**/provenance.json
/public/images/**/*.webp.json

# Reproducible isolated template build products; keep sources and licensed fonts.
/public/template-site-assets/entries/
/public/template-site-assets/chunks/
/public/template-site-assets/assets/
/public/template-site-assets/template-base.css
/public/template-site-assets/fonts.css
/src/lib/template-sites-manifest.json
/vendor/stylekit-templates/entries/
/vendor/stylekit-templates/template-base.css
/vendor/stylekit-templates/build-metafile.json
/vendor/stylekit-templates/qa.json
